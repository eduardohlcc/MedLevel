# ==============================================================================
# MedLevel - Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Node Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database (matching docker-compose.yml)
DATABASE_URL=postgresql://medlevel_user:medlevel_password@localhost:5432/medlevel_db?schema=public

# JWT Security
JWT_ACCESS_SECRET=medlevel_super_secret_access_jwt_key_change_in_production
JWT_REFRESH_SECRET=medlevel_super_secret_refresh_jwt_key_change_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Simulated Email / Notifications
EMAIL_FROM=suporte@medlevel.com.br

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_APP_NAME=MedLevel
NEXT_PUBLIC_DISCLAIMER="Material de estudo. Não substitui diretrizes oficiais nem orientação clínica."
