{
  "name": "medlevel-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for MedLevel medical education platform (ENAMED preparation)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:frontend:mock": "npm run dev:mock --workspace=frontend",
    "dev:backend": "npm run start:dev --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate --workspace=backend",
    "db:seed": "npm run prisma:seed --workspace=backend"
  },
  "keywords": [
    "medlevel",
    "enamed",
    "medical-education",
    "spaced-repetition",
    "sm2",
    "nextjs",
    "nestjs"
  ],
  "author": "MedLevel Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "prettier": "^3.2.5"
  }
}
